%% Modernized design (Go). Original upstream PNG kept as class-diagram.png.
classDiagram
    direction TB

    class CoffeeMachine {
        +NewCoffeeMachine()
        +Menu() []string
        +SelectCoffee(name string) Coffee, error
        +DispenseCoffee(coffee Coffee, payment Payment) float64, error
    }

    class Coffee {
        +Name() string
        +Price() float64
        +Recipe() map
    }

    class Ingredient {
        +Name() string
        +Quantity() int
        +UpdateQuantity(delta int)
    }

    class Payment {
        +NewPayment(amount float64)
    }

    CoffeeMachine "1" --> "*" Coffee : menu
    CoffeeMachine "1" --> "*" Ingredient : inventory
    Coffee "1" --> "*" Ingredient : recipe uses
    CoffeeMachine ..> Payment : accepts
