%% Modernized design (Go). Original upstream PNG kept as class-diagram.png.
classDiagram
    direction TB

    class TaskManager {
        +NewTaskManager()
        +CreateTask(task Task) error
        +UpdateTask(task Task) error
        +DeleteTask(taskID string) error
        +SearchTasks(keyword string) Task[]
        +FilterTasks(status, dates, priority) Task[]
        +MarkTaskAsCompleted(taskID string) error
        +TaskHistory(user User) Task[]
    }

    class Task {
        +NewTask(id, title, desc, dueDate, priority, user)
        Id string
        Title string
        Status TaskStatus
    }

    class User {
        +NewUser(id, name, email string)
        Id string
        Name string
    }

    class TaskStatus {
        <<enumeration>>
        Pending
        InProgress
        Completed
    }

    TaskManager "1" --> "*" Task : tasks
    TaskManager "1" --> "*" User : users via assignments
    Task "1" --> "1" User : assignedUser
    Task --> TaskStatus : status
